index 0000000..708b25c
--- /dev/null
+++ b/app/App/TonTonEmbeddedEntry.swift
@@ -0,0 +1,32 @@
+import UIKit
+import GTAEmbeddedABI
+
+enum TTGTAContext {
+    static let bundle: Bundle = TTGTABundle()
+    static let defaults: UserDefaults = TTGTADefaults()
+    static var documents: URL { URL(fileURLWithPath: TTGTADocuments(), isDirectory: true) }
+}
+
+@objc(TonTonGTAEmbeddedEntry)
+final class TonTonGTAEmbeddedEntry: NSObject {
+    private static var controller: NativePortViewController?
+
+    @objc(controllerForSlot:returnToLibrary:)
+    static func controller(forSlot slot: String, returnToLibrary: @escaping () -> Void) -> UIViewController? {
+        guard Thread.isMainThread else { return nil }
+        let documents = URL(fileURLWithPath: slot, isDirectory: true).appendingPathComponent("UserData", isDirectory: true)
+        let manifest = documents.appendingPathComponent("GTA V/data/manifest.json")
+        guard FileManager.default.isReadableFile(atPath: manifest.path) else { return nil }
+        if let previous = controller {
+            previous.returnToGameBox = returnToLibrary
+            return previous
+        }
+        TTGTASetDocuments(documents.path)
+        GameSettings.applyExperimentalSwitches()
+        ModKeyRemap.apply()
+        let game = NativePortViewController()
+        game.returnToGameBox = returnToLibrary
+        controller = game
+        return game
+    }
+}
