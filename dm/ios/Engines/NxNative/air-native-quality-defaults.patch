-// MKW's native NVN host supports these settings even for data-only imports
-// that did not ship a launcher schema.
+// Signed Switch frameworks can arrive with a data-only import and no
+// launcher.json. Both controls are implemented by the native host.
+static BOOL TTIsSignedSwitchTitle(NSString *title){
+    NSString *upper=title.uppercaseString;
+    if(upper.length!=16||(![upper hasPrefix:@"01"]&&![upper hasPrefix:@"04"]))return NO;
+    if([upper rangeOfCharacterFromSet:[[NSCharacterSet characterSetWithCharactersInString:@"0123456789ABCDEF"] invertedSet]].location!=NSNotFound)return NO;
+    NSString *name=[NSString stringWithFormat:@"DmGame%@.framework/DmGame",upper];
+    return [NSFileManager.defaultManager fileExistsAtPath:[NSBundle.mainBundle.privateFrameworksPath stringByAppendingPathComponent:name]];
+}
