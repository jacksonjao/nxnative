+            settings.frameRateCap = value
+        }
+        if let value = options["GTA_HEIGHT"].flatMap(Int.init), [480, 540, 640, 720, 900, 1080].contains(value) {
+            settings.renderHeight = value
+        }
+        let supported = ["GTA_TEXTURE_QUALITY": "textureQuality", "GTA_SHADOW_QUALITY": "shadowQuality",
+                         "GTA_REFLECTION_QUALITY": "reflectionQuality", "GTA_PARTICLE_QUALITY": "particleQuality",
+                         "GTA_GRASS_QUALITY": "grassQuality"]
+        var overrides = settings.graphicsOverrides
+        for (key, name) in supported {
+            if let value = options[key], let spec = GraphicsDetail.all.first(where: { $0.option == name }),
+               spec.values.contains(value) { overrides[name] = value }
+        }
+        settings.graphicsOverrides = overrides
+        launchFromGameBox = true
+    }
