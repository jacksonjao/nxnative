+#import "TTGTAEmbeddedContext.h"
+@interface TTGTAResourceAnchor : NSObject
+@end
+@implementation TTGTAResourceAnchor
+@end
+static NSString *TTGTADocumentsPath;
+NSBundle *TTGTABundle(void) { return [NSBundle bundleForClass:TTGTAResourceAnchor.class]; }
+NSString *TTGTADocuments(void) { return TTGTADocumentsPath; }
+void TTGTASetDocuments(NSString *directory) { TTGTADocumentsPath = [directory copy]; }
+NSUserDefaults *TTGTADefaults(void) {
+    static NSUserDefaults *prefs;
+    static dispatch_once_t once;
+    dispatch_once(&once, ^{ prefs = [[NSUserDefaults alloc] initWithSuiteName:@"com.tonytan.nxgamelibrary.gta-native"]; });
+    return prefs;
+}
